<%
const posts = (page.posts ? page.posts.toArray() : site.posts.sort('date', -1).toArray());
const latestPost = posts[0];
const summarize = (input, limit = 140) => {
  const plain = String(input || '')
    .replace(/<[^>]+>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
  return plain.length > limit ? `${plain.slice(0, limit).trim()}...` : plain;
};
%>
<header class="hero">
  <nav class="nav container">
    <a class="brand" href="<%- url_for('/') %>"><%= config.title %></a>
    <div class="nav-links">
      <a href="<%- url_for('/archives/') %>" data-i18n-key="nav.archives">Archives</a>
      <a href="<%- url_for('/news/') %>" data-i18n-key="nav.news">News</a>
      <a href="<%- url_for('/about/') %>" data-i18n-key="nav.about">About</a>
      <a href="<%- url_for('/rss.xml') %>" aria-label="RSS">RSS</a>
      <button class="site-search-trigger" data-site-search-trigger data-i18n-key="nav.search" data-i18n-aria-label-key="nav.search" aria-label="Search">Search</button>
      <button class="theme-toggle" data-theme-toggle data-i18n-key="nav.theme" data-i18n-aria-label-key="nav.theme" aria-pressed="false" aria-label="Theme">Theme</button>
      <button class="shortcut-help-trigger" type="button" data-shortcut-help-trigger aria-label="Shortcuts" title="Shortcuts">?</button>
      <button class="lang-toggle" data-lang-toggle data-i18n-key="nav.lang" aria-label="切换为中文">中文</button>
    </div>
  </nav>

  <section class="hero-content container">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="tag">HELLO</p>
        <h1>I am Evan Zhang,<br />an Agent Application Engineer (Full Stack)</h1>
        <p class="subtitle">Previously a Java backend engineer, now focused on Agent application development and full stack engineering at Alibaba Group (Beijing).</p>
        <div class="actions">
          <a class="btn primary" href="#writing">Latest Writing</a>
          <a class="btn ghost" href="https://github.com/xdlkc" target="_blank" rel="noreferrer">GitHub</a>
        </div>
      </div>

      <aside class="hero-panel">
        <p class="hero-panel-eyebrow">PROFILE</p>
        <div class="hero-panel-item">
          <span class="hero-panel-label">Focus</span>
          <strong>Agent Apps</strong>
        </div>
        <div class="hero-panel-item">
          <span class="hero-panel-label">Stack</span>
          <strong>Full Stack + Engineering</strong>
        </div>
        <div class="hero-panel-item">
          <span class="hero-panel-label">Base</span>
          <strong>Beijing</strong>
        </div>
        <% if (latestPost) { %>
          <div class="hero-panel-feature">
            <span class="hero-panel-label">Latest</span>
            <a href="<%- url_for(latestPost.path) %>"><%= latestPost.title %></a>
          </div>
        <% } %>
      </aside>
    </div>
  </section>
</header>

<main id="main-content" tabindex="-1">
  <section id="projects" class="section container">
    <h2 data-i18n-key="index.projects">Projects</h2>
    <div class="grid">
      <article class="card">
        <h3>AgentForge</h3>
        <p>An engineering-focused project for Agent applications, covering end-to-end practices from backend capability encapsulation to frontend interaction delivery.</p>
        <a href="https://github.com/xdlkc/AgentForge" target="_blank" rel="noreferrer" data-i18n-key="index.viewRepo">View Repository</a>
      </article>

      <article class="card">
        <h3>skills-manager</h3>
        <p>A tool for managing Agent skill configurations and version evolution, improving consistency and delivery efficiency in multi-skill collaboration.</p>
        <a href="https://github.com/xdlkc/skills-manager" target="_blank" rel="noreferrer" data-i18n-key="index.viewRepo">View Repository</a>
      </article>
    </div>
  </section>

  <section id="writing" class="section container">
    <h2 data-i18n-key="index.latestWriting">Latest Writing</h2>
    <div class="grid">
      <% posts.slice(0, 6).forEach((post) => { %>
        <article class="card">
          <h3><%= post.title %></h3>
          <p><%= summarize(post.excerpt || post.content) %></p>
          <a href="<%- url_for(post.path) %>" data-i18n-key="index.readArticle">Read Article</a>
        </article>
      <% }) %>
    </div>
  </section>

  <%
  const latestNews = (typeof latest_news === 'function' ? latest_news() : []);
  const formatNewsTime = (iso) => {
    if (!iso) return '';
    const d = new Date(iso);
    return Number.isFinite(d.getTime())
      ? d.toLocaleDateString('zh-CN', { timeZone: 'Asia/Shanghai' })
      : String(iso).slice(0, 10);
  };
  %>
  <% if (latestNews.length) { %>
    <section id="news" class="section container">
      <h2 data-i18n-key="index.news.latest">Latest News</h2>
      <div class="grid">
        <% latestNews.forEach((n) => { %>
          <article class="card">
            <h3 style="margin-bottom: 0.4rem;"><a href="<%= n.url %>" target="_blank" rel="noreferrer"><%= n.title %></a></h3>
            <p style="opacity: 0.75; margin: 0 0 0.5rem 0;"><%= formatNewsTime(n.publishedAt) %><% if (n.source) { %> · <%= n.source %><% } %></p>
            <% if (n.summary) { %><p><%= n.summary %></p><% } %>
          </article>
        <% }) %>
      </div>
      <p style="margin-top: 0.75rem;"><a href="<%- url_for('/news/') %>" data-i18n-key="index.news.all">View all news -></a></p>
    </section>
  <% } %>

  <section id="about" class="section container">
    <h2 data-i18n-key="index.about">About</h2>
    <div class="grid info-grid">
      <% if (latestPost) { %>
        <article class="card info-card info-card-focus">
          <p class="info-card-eyebrow" data-i18n-key="index.currentFocus">Current Focus</p>
          <h3><%= latestPost.title %></h3>
          <p><%= summarize(latestPost.excerpt || latestPost.content, 220) %></p>
          <a href="<%- url_for(latestPost.path) %>" data-i18n-key="index.readArticle">Read Article</a>
        </article>
      <% } %>

      <article class="card info-card">
        <p class="info-card-eyebrow" data-i18n-key="index.about">About</p>
        <h3>Agent Application Engineer</h3>
        <p>
          I studied at Xidian University from 2014 to 2018 for my bachelor's degree and currently work at Alibaba Group (Beijing).
          I started as a Java backend engineer and now focus on Agent application development and full stack engineering, with an emphasis on engineering quality and delivery efficiency.
        </p>
      </article>

      <article class="card info-card info-card-contact">
        <p class="info-card-eyebrow" data-i18n-key="index.contact">Contact</p>
        <h3>Find Me</h3>
        <p>Email: <a href="mailto:wimness@163.com">wimness@163.com</a></p>
        <p>GitHub: <a href="https://github.com/xdlkc" target="_blank" rel="noreferrer">@xdlkc</a></p>
      </article>
    </div>
  </section>
</main>

<footer class="footer">
  <p>© <%= new Date().getFullYear() %> <%= config.title %>. <span data-i18n-key="footer.copyright">All rights reserved.</span></p>
</footer>
