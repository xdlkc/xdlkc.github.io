<%
const posts = (page.posts ? page.posts.toArray() : site.posts.sort('date', -1).toArray());
const latestPost = posts[0];
const summarize = (input, limit = 140) => {
  const plain = String(input || '')
    .replace(/<[^>]+>/g, ' ')
    .replace(/https?:\/\/[^\s<>()]+/gi, ' ')
    .replace(/\(\s*\)|\[\s*\]/g, ' ')
    .replace(/(?:原文链接|原文|来源|参考链接|链接|URL)\s*[:：]\s*(?=[,，。.;；\s]|$)/gi, ' ')
    .replace(/\s+/g, ' ')
    .trim();
  return plain.length > limit ? `${plain.slice(0, limit).trim()}...` : plain;
};
%>
<header class="hero">
  <%- partial('_partial/header', { navClass: 'nav container', activeSection: 'home' }) %>

  <section class="hero-content container">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="tag" data-i18n-key="index.hero.tag">HELLO</p>
        <h1><span data-i18n-key="index.hero.titleLine1">Hi, I'm Evan Zhang.</span><br /><span class="hero-title-muted" data-i18n-key="index.hero.titleLine2">AI Infra &amp; Agent Engineer.</span></h1>
        <p class="subtitle" data-i18n-key="index.hero.subtitle">Working on AI Agent infrastructure and crafting local-first developer tools.</p>
        <div class="actions">
          <a class="btn primary" href="#writing" data-i18n-key="index.latestWriting">Latest Writing</a>
          <a class="btn ghost" href="https://github.com/xdlkc" target="_blank" rel="noreferrer">GitHub ↗</a>
        </div>
      </div>

      <aside class="hero-panel">
        <p class="hero-panel-eyebrow" data-i18n-key="index.profile.eyebrow">PROFILE</p>
        <dl class="hero-profile-list">
          <div class="hero-profile-row">
            <dt class="hero-panel-label" data-i18n-key="index.profile.focusLabel">Focus</dt>
            <dd data-i18n-key="index.profile.focusValue">AI Infra · Agent</dd>
          </div>
          <div class="hero-profile-row">
            <dt class="hero-panel-label" data-i18n-key="index.profile.stackLabel">Stack</dt>
            <dd data-i18n-key="index.profile.stackValue">Rust · Python · Go · TS · Swift</dd>
          </div>
          <div class="hero-profile-row">
            <dt class="hero-panel-label" data-i18n-key="index.profile.baseLabel">Base</dt>
            <dd data-i18n-key="index.profile.baseValue">Beijing</dd>
          </div>
        </dl>
        <% if (latestPost) { %>
          <a class="hero-panel-latest" href="<%- url_for(latestPost.path) %>">
            <span class="hero-panel-label" data-i18n-key="index.profile.latestLabel">Latest</span>
            <span class="hero-panel-latest-title"><%= latestPost.title %> <span aria-hidden="true">→</span></span>
          </a>
        <% } %>
      </aside>
    </div>
  </section>
</header>

<main id="main-content" tabindex="-1">
  <section id="projects" class="section container">
    <div class="section-head">
      <h2 data-i18n-key="index.projects">Projects</h2>
      <a class="section-cta" href="https://github.com/xdlkc?tab=repositories" target="_blank" rel="noreferrer" data-i18n-key="index.projects.all">View all repos →</a>
    </div>
    <div class="grid">
      <article class="card card-project">
        <div class="card-head">
          <h3><a class="card-title-link card-link-stretched" href="https://github.com/xdlkc/nexus" target="_blank" rel="noreferrer">nexus</a></h3>
          <span class="card-ext-icon" aria-hidden="true">↗</span>
        </div>
        <p class="card-desc" data-i18n-key="index.project.nexus">Event-driven, dual-engine Super-Agent control plane and polymorphic worker runtime built in Rust and TypeScript.</p>
        <div class="card-tags">
          <span class="card-tag">Rust</span>
          <span class="card-tag">Agent</span>
        </div>
      </article>

      <article class="card card-project">
        <div class="card-head">
          <h3><a class="card-title-link card-link-stretched" href="https://github.com/xdlkc/loom" target="_blank" rel="noreferrer">loom</a></h3>
          <span class="card-ext-icon" aria-hidden="true">↗</span>
        </div>
        <p class="card-desc" data-i18n-key="index.project.loom">Local-only unified Rust model gateway (OpenAI &amp; Anthropic APIs) with a loopback observability console.</p>
        <div class="card-tags">
          <span class="card-tag">Rust</span>
          <span class="card-tag">Gateway</span>
        </div>
      </article>

      <article class="card card-project">
        <div class="card-head">
          <h3><a class="card-title-link card-link-stretched" href="https://github.com/xdlkc/verba" target="_blank" rel="noreferrer">verba</a></h3>
          <span class="card-ext-icon" aria-hidden="true">↗</span>
        </div>
        <p class="card-desc" data-i18n-key="index.project.verba">Local-first macOS live bilingual subtitles and structured meeting notes with pinyin search and Obsidian sync.</p>
        <div class="card-tags">
          <span class="card-tag">Rust</span>
          <span class="card-tag">macOS</span>
        </div>
      </article>

      <article class="card card-project">
        <div class="card-head">
          <h3><a class="card-title-link card-link-stretched" href="https://github.com/xdlkc/scribeleaf" target="_blank" rel="noreferrer">scribeleaf</a></h3>
          <span class="card-ext-icon" aria-hidden="true">↗</span>
        </div>
        <p class="card-desc" data-i18n-key="index.project.scribeleaf">Native macOS Markdown editor built with AppKit, WKWebView &amp; CodeMirror 6 for live preview and multi-format export.</p>
        <div class="card-tags">
          <span class="card-tag">macOS</span>
          <span class="card-tag">Markdown</span>
        </div>
      </article>

      <article class="card card-project">
        <div class="card-head">
          <h3><a class="card-title-link card-link-stretched" href="https://github.com/xdlkc/lstack" target="_blank" rel="noreferrer">lstack</a></h3>
          <span class="card-ext-icon" aria-hidden="true">↗</span>
        </div>
        <p class="card-desc" data-i18n-key="index.project.lstack">Personal Agent Skills stack for engineering and productivity across Antigravity, Claude Code, Codex, Gemini CLI, and Cursor.</p>
        <div class="card-tags">
          <span class="card-tag">Agent Skills</span>
          <span class="card-tag">Workflow</span>
        </div>
      </article>

      <article class="card card-project">
        <div class="card-head">
          <h3><a class="card-title-link card-link-stretched" href="https://github.com/xdlkc/AgentForge" target="_blank" rel="noreferrer">AgentForge</a></h3>
          <span class="card-ext-icon" aria-hidden="true">↗</span>
        </div>
        <p class="card-desc" data-i18n-key="index.project.agentForge">Agent Skills package implementing Spec-Driven Development (SDD) with a six-phase workflow, EARS templates, and validation scripts.</p>
        <div class="card-tags">
          <span class="card-tag">SDD</span>
          <span class="card-tag">Agent</span>
        </div>
      </article>
    </div>
  </section>

  <section id="writing" class="section container">
    <div class="section-head">
      <h2 data-i18n-key="index.latestWriting">Latest Writing</h2>
      <a class="section-cta" href="<%- url_for('/archives/') %>" data-i18n-key="index.writing.all">View all articles →</a>
    </div>
    <div class="writing-grid">
      <% posts.slice(0, 6).forEach((post) => {
        const postDate = post.date ? (typeof date === 'function' ? date(post.date, 'YYYY-MM-DD') : String(post.date).slice(0, 10)) : '';
        const postTags = (post.tags && post.tags.length) ? post.tags.toArray().slice(0, 3) : [];
      %>
        <article class="card card-post">
          <% if (postDate) { %>
            <div class="card-meta">
              <time datetime="<%= postDate %>"><%= postDate %></time>
            </div>
          <% } %>
          <h3 class="card-title-clamp"><a class="card-title-link card-link-stretched" href="<%- url_for(post.path) %>"><%= post.title %></a></h3>
          <p class="card-desc card-desc-2"><%= summarize(post.description || post.excerpt || post.content, 120) %></p>
          <% if (postTags.length) { %>
            <div class="card-tags">
              <% postTags.forEach((tag) => { %>
                <span class="card-tag">#<%= tag.name %></span>
              <% }) %>
            </div>
          <% } %>
        </article>
      <% }) %>
    </div>
  </section>

  <%
  const latestNews = (typeof latest_news === 'function' ? latest_news(6) : []);
  const formatNewsTime = (iso) => {
    if (!iso) return '';
    const d = new Date(iso);
    return Number.isFinite(d.getTime())
      ? d.toLocaleDateString('zh-CN', { timeZone: 'Asia/Shanghai' })
      : String(iso).slice(0, 10);
  };
  %>
  <% if (latestNews.length) { %>
    <section id="news" class="section container">
      <div class="section-head">
        <h2 data-i18n-key="index.news.latest">Latest News</h2>
        <a class="section-cta" href="<%- url_for('/news/') %>" data-i18n-key="index.news.all">View all news →</a>
      </div>
      <div class="news-grid">
        <% latestNews.forEach((n) => { %>
          <article class="card card-news">
            <div class="card-meta">
              <time><%= formatNewsTime(n.publishedAt) %></time>
              <% if (n.source) { %><span class="card-meta-sep" aria-hidden="true">·</span><span><%= n.source %></span><% } %>
            </div>
            <h3 class="card-title-clamp"><a class="card-title-link card-link-stretched" href="<%= n.url %>" target="_blank" rel="noreferrer"><%= n.title %></a></h3>
            <% if (n.summary) { %><p class="card-desc card-desc-2"><%= n.summary %></p><% } %>
          </article>
        <% }) %>
      </div>
    </section>
  <% } %>

  <section id="about" class="section container">
    <div class="section-head">
      <h2 data-i18n-key="index.about">About</h2>
    </div>
    <div class="about-grid">
      <article class="card about-bio-card">
        <h3 data-i18n-key="index.aboutCard.role">AI Infra &amp; Agent Engineer</h3>
        <p data-i18n-key="index.aboutCard.bio">
          Software engineer based in Beijing working on AI infrastructure and Agent platforms. Outside work, I enjoy exploring AI-native workflows and building local-first developer tools and native macOS apps.
        </p>
        <div class="card-tags">
          <span class="card-tag">AI Infra</span>
          <span class="card-tag">Agent Tooling</span>
          <span class="card-tag">macOS</span>
        </div>
      </article>

      <article class="card about-contact-card">
        <h3 data-i18n-key="index.contactCard.title">Find Me</h3>
        <div class="contact-list">
          <a class="contact-row" href="mailto:wimness@163.com">
            <span class="contact-label" data-i18n-key="index.contactCard.emailLabel">Email</span>
            <span class="contact-value">wimness@163.com ↗</span>
          </a>
          <a class="contact-row" href="https://github.com/xdlkc" target="_blank" rel="noreferrer">
            <span class="contact-label">GitHub</span>
            <span class="contact-value">@xdlkc ↗</span>
          </a>
          <a class="contact-row" href="<%- url_for('/rss.xml') %>">
            <span class="contact-label">RSS</span>
            <span class="contact-value">/rss.xml ↗</span>
          </a>
        </div>
      </article>
    </div>
  </section>
</main>

<footer class="footer">
  <p>© <%= new Date().getFullYear() %> <%= config.title %>. <span data-i18n-key="footer.copyright">All rights reserved.</span></p>
</footer>
