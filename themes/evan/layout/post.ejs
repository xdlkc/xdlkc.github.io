<% const postToc = toc(page.content, { class: 'toc-nav', max_depth: 3, list_number: false }); %>
<% const relatedPosts = related_posts_detailed(page, site, { limit: 6, sharedTagsLimit: 3, fallbackRecent: true }); %>
<% const comments = config.comments || {}; %>
<% const utterances = comments.utterances || {}; %>
<% const primaryCategory = (page.categories && page.categories.data && page.categories.data.length)
  ? page.categories.data[0]
  : (Array.isArray(page.categories) && page.categories.length ? page.categories[0] : null);
%>
<% const primaryCategoryName = primaryCategory && primaryCategory.name ? String(primaryCategory.name) : ''; %>
<% const primaryCategoryUrl = primaryCategory
  ? (primaryCategory.path ? url_for(primaryCategory.path) : url_for('/categories/' + primaryCategoryName + '/'))
  : '';
%>
<article class="article-shell container">
  <div class="reading-progress" data-reading-minutes="<%= reading_time(page.content) %>" role="progressbar" tabindex="0" aria-label="阅读进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
    <div class="reading-progress-bar"></div>
  </div>

  <nav class="article-nav">
    <a class="brand" href="<%- url_for('/') %>"><%= config.title %></a>
    <div class="nav-links">
      <a href="<%- url_for('/archives/') %>" data-i18n-key="nav.archives">Archives</a>
      <a href="<%- url_for('/news/') %>" data-i18n-key="nav.news">News</a>
      <a href="<%- url_for('/about/') %>" data-i18n-key="nav.about">About</a>
      <a href="<%- url_for('/rss.xml') %>" aria-label="RSS">RSS</a>
      <button class="random-post-button" data-random-post data-i18n-key="nav.random" data-i18n-aria-label-key="nav.random" aria-label="Random post" data-posts='<%- JSON.stringify(site.posts.map(p => ({ path: p.path, title: p.title }))) %>'>Random</button>
      <button class="site-search-trigger" data-site-search-trigger data-i18n-key="nav.search" data-i18n-aria-label-key="nav.search" aria-label="Search">Search</button>
      <button class="font-size-toggle" data-font-size-toggle data-i18n-key="nav.font" data-i18n-aria-label-key="nav.font" aria-label="Font size">Font</button>
      <button class="theme-toggle" data-theme-toggle data-i18n-key="nav.theme" data-i18n-aria-label-key="nav.theme" aria-pressed="false" aria-label="Theme">Theme</button>
      <button class="shortcut-help-trigger" type="button" data-shortcut-help-trigger aria-label="Shortcuts" title="Shortcuts">?</button>
      <button class="lang-toggle" data-lang-toggle data-i18n-key="nav.lang" aria-label="切换为中文">中文</button>
    </div>
  </nav>

  <header class="article-hero">
    <p class="tag">LATEST WRITING</p>
    <nav data-breadcrumb
      data-breadcrumb-title="<%- page.title %>"
      <% if (primaryCategoryName && primaryCategoryUrl) { %>
        data-breadcrumb-category="<%- primaryCategoryName %>"
        data-breadcrumb-category-url="<%- primaryCategoryUrl %>"
      <% } %>
    ></nav>
    <h1><%= page.title %></h1>
    <p class="article-meta">
      <span data-i18n-key="post.published">Published</span>
      <span class="article-meta-date"><%= date(page.date, 'YYYY-MM-DD') %></span>
      (<span data-publish-date="<%= date(page.date, 'YYYY-MM-DDTHH:mm:ssZ') %>">加载中...</span>)
      <%- updated_label() %>
      · <span class="article-meta-word-count"><span data-i18n-key="post.words">Words</span> · <%= post_word_count(page.content) %></span>
      · <span class="article-meta-reading-time"><span data-i18n-key="post.reading">Reading</span> · <%= reading_time(page.content) %> <span data-i18n-key="post.min">min</span></span>
      · <span class="article-meta-reading-time-countdown" data-reading-time-countdown aria-live="polite"></span>
    </p>
    <% if (page.tags && page.tags.length > 0) { %>
      <div class="article-meta-tags" aria-label="Tags">
        <% page.tags.forEach(function(tag, index) { %>
          <a class="article-meta-tag" href="<%- url_for(tag.path) %>" aria-label="Tag: <%= tag.name %>"><%- tag.name %></a><% if (index < page.tags.length - 1) { %> <% } %>
        <% }); %>
      </div>
    <% } %>
    <button class="code-line-numbers-toggle" type="button" data-code-line-numbers-toggle aria-pressed="false" title="Toggle code line numbers (l)">行号：开</button>
    <button class="article-link-copy" type="button" data-article-link-copy data-i18n-key="post.copyLink" data-i18n-aria-label-key="post.copyLink" aria-label="Copy article link">Copy Link</button>
    <button class="post-bookmark" type="button" data-post-bookmark data-i18n-key="post.bookmark" data-i18n-aria-label-key="post.bookmark" aria-label="Bookmark this article" data-post-path="<%= page.path %>" data-post-title="<%= page.title %>">🔖 Bookmark (0)</button>
    <button class="post-like" type="button" data-post-like aria-pressed="false">👍 Like (0)</button>

    <div class="article-share" data-article-share data-article-title="<%= page.title %>" data-article-url="<%= url_for(page.path, { external: true }) %>">
      <span class="article-share-label" data-i18n-key="post.share">Share:</span>
      <a class="article-share-link article-share-twitter" href="#" data-share-platform="twitter" aria-label="Share to Twitter">Twitter</a>
      <a class="article-share-link article-share-weibo" href="#" data-share-platform="weibo" aria-label="Share to Weibo">Weibo</a>
      <a class="article-share-link article-share-linkedin" href="#" data-share-platform="linkedin" aria-label="Share to LinkedIn">LinkedIn</a>
      <button class="article-share-link article-share-wechat" type="button" data-share-platform="wechat" aria-label="Share to WeChat">WeChat</button>
    </div>
    <% if (page.excerpt) { %>
      <p class="article-summary"><%= strip_html(page.excerpt) %></p>
    <% } %>
  </header>

  <div class="article-layout">
    <main id="main-content" class="article-card" tabindex="-1">
      <% if (postToc && postToc.trim()) { %>
        <div class="toc-sidebar-mobile"> <!-- Wrap for mobile-specific styles if needed -->
          <details class="toc-mobile">
            <summary data-i18n-key="post.toc">Outline</summary>
            <div class="toc-mobile-body">
              <%- postToc %>
            </div>
          </details>
        </div>
      <% } %>
      <article class="article-content"><%- page.content %></article>

      <% if (comments.enable && comments.provider === 'utterances' && utterances.repo) { %>
        <section class="post-comments" aria-label="comments">
          <h2 class="post-comments-title" data-i18n-key="post.comments">Comments</h2>
          <div class="post-comments-box" data-comments-root></div>
          <noscript data-i18n-key="post.commentsNoscript">Enable JavaScript to view comments.</noscript>
        </section>
      <% } %>

      <% if (page.prev || page.next) { %>
        <nav class="post-navigation" aria-label="article navigation">
          <% if (page.prev) { %>
            <a class="post-navigation-prev" href="<%- url_for(page.prev.path) %>" aria-label="Previous article: <%= page.prev.title %>">
              <span class="post-navigation-label" data-i18n-key="post.previous">← Previous</span>
              <span class="post-navigation-title"><%= page.prev.title %></span>
            </a>
          <% } else { %>
            <div class="post-navigation-placeholder"></div>
          <% } %>
          <% if (page.next) { %>
            <a class="post-navigation-next" href="<%- url_for(page.next.path) %>" aria-label="Next article: <%= page.next.title %>">
              <span class="post-navigation-title"><%= page.next.title %></span>
              <span class="post-navigation-label" data-i18n-key="post.next">Next →</span>
            </a>
          <% } else { %>
            <div class="post-navigation-placeholder"></div>
          <% } %>
        </nav>
      <% } %>

      <% if (relatedPosts && relatedPosts.length) { %>
        <section class="related-posts" aria-label="related posts">
          <h2 class="related-posts-title" data-i18n-key="post.related">Related Posts</h2>
          <ul class="related-posts-list">
            <% relatedPosts.forEach(function(row) { %>
              <% const post = row.post; %>
              <li class="related-posts-item">
                <div class="related-posts-main">
                  <div class="related-posts-head">
                    <a class="related-posts-link" href="<%- url_for(post.path) %>"><%= post.title %></a>
                    <% if (row.reason === 'tags') { %>
                      <span class="related-posts-reason" data-i18n-key="post.relatedReason.tags">Shared tags</span>
                    <% } else if (row.reason === 'keywords') { %>
                      <span class="related-posts-reason" data-i18n-key="post.relatedReason.keywords">Shared keywords</span>
                    <% } else if (row.reason === 'recent') { %>
                      <span class="related-posts-reason" data-i18n-key="post.relatedReason.recent">Recent</span>
                    <% } %>
                  </div>

                  <% const relatedExcerpt = related_posts_excerpt(post, { maxLength: 120 }); %>
                  <% if (relatedExcerpt) { %>
                    <p class="related-posts-excerpt"><%= relatedExcerpt %></p>
                  <% } %>

                  <% if (row.sharedTags && row.sharedTags.length) { %>
                    <div class="related-posts-tags" aria-label="共享标签">
                      <% row.sharedTags.forEach(function(tag) { %>
                        <button
                          class="related-posts-tag"
                          type="button"
                          data-site-search-open
                          data-site-search-keyword="<%= tag %>"
                          data-site-search-keyword-mode="tag"
                          aria-label="Search tag: <%= tag %>"
                        ><%= tag %></button>
                      <% }); %>
                    </div>
                  <% } %>
                  <% if (row.sharedKeywords && row.sharedKeywords.length) { %>
                    <div class="related-posts-keywords" aria-label="共享关键词">
                      <% row.sharedKeywords.forEach(function(keyword) { %>
                        <button
                          class="related-posts-keyword"
                          type="button"
                          data-site-search-open
                          data-site-search-keyword="<%= keyword %>"
                          aria-label="Search keyword: <%= keyword %>"
                        ><%= keyword %></button>
                      <% }); %>
                    </div>
                  <% } %>
                </div>
                <% if (post.date) { %>
                  <span class="related-posts-meta"><%= date(post.date, 'YYYY-MM-DD') %></span>
                <% } %>
              </li>
            <% }); %>
          </ul>
        </section>
      <% } %>

      <!-- 打印元数据：打印时在文章底部显示来源和日期 -->
      <div class="print-meta"
           data-print-url="<%= url_for(page.path, { external: true }) %>"
           data-print-date="<%= date(Date.now(), 'YYYY-MM-DD') %>"></div>
    </main>

    <% if (postToc && postToc.trim()) { %>
      <aside class="toc-card toc-sidebar" data-toc-sidebar>
        <div class="toc-header">
          <p class="toc-title" data-i18n-key="post.outline">Outline</p>
          <button class="toc-toggle-button" type="button" data-toc-toggle aria-expanded="true" aria-controls="toc-content-desktop">折叠目录</button>
        </div>
        <div class="toc-content" id="toc-content-desktop">
          <%- postToc %>
        </div>
      </aside>
    <% } %>
  </div>
</article>

<% if (comments.enable && comments.provider === 'utterances' && utterances.repo) { %>
<script>
  (function initPostComments() {
    const mount = document.querySelector('[data-comments-root]');
    if (!mount) return;

    const commentsConfig = {
      repo: '<%- utterances.repo %>',
      issueTerm: '<%- utterances.issue_term || "pathname" %>',
      label: '<%- utterances.label || "comment" %>',
      loading: '<%- utterances.loading || "lazy" %>',
      themeLight: '<%- ((utterances.theme || {}).light) || "github-light" %>',
      themeDark: '<%- ((utterances.theme || {}).dark) || "github-dark" %>'
    };

    function resolveTheme() {
      return document.documentElement.dataset.theme === 'dark'
        ? commentsConfig.themeDark
        : commentsConfig.themeLight;
    }

    function mountUtterances() {
      const script = document.createElement('script');
      script.src = 'https://utteranc.es/client.js';
      script.async = true;
      script.crossOrigin = 'anonymous';
      script.setAttribute('repo', commentsConfig.repo);
      script.setAttribute('issue-term', commentsConfig.issueTerm);
      script.setAttribute('label', commentsConfig.label);
      script.setAttribute('theme', resolveTheme());
      script.setAttribute('loading', commentsConfig.loading);
      mount.appendChild(script);
    }

    function syncUtterancesTheme() {
      const iframe = mount.querySelector('iframe.utterances-frame');
      if (!iframe || !iframe.contentWindow) return;
      iframe.contentWindow.postMessage(
        { type: 'set-theme', theme: resolveTheme() },
        'https://utteranc.es'
      );
    }

    mountUtterances();

    const observer = new MutationObserver(syncUtterancesTheme);
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme']
    });
  })();
</script>
<% } %>

<script src="<%- url_for('/js/toc-scrollspy.js') %>" defer></script>
<script src="<%- url_for('/js/reading-progress.js') %>" defer></script>
<script src="<%- url_for('/js/reading-time-countdown.js') %>" defer></script>
<script src="<%- url_for('/js/breadcrumb.js') %>" defer></script>
<script src="<%- url_for('/js/heading-anchor-copy.js') %>" defer></script>
<script src="<%- url_for('/js/article-link-copy.js') %>" defer></script>
<script src="<%- url_for('/js/post-like.js') %>" defer></script>
<script src="<%- url_for('/js/post-bookmark.js') %>" defer></script>
<script src="<%- url_for('/js/post-bookmark-ui.js') %>" defer></script>
<script src="<%- url_for('/js/image-open.js') %>" defer></script>
<script src="<%- url_for('/js/mermaid-enhance.js') %>" defer></script>
<script src="<%- url_for('/js/mermaid-click-to-zoom.js') %>" defer></script>
<script src="<%- url_for('/js/code-language-label.js') %>" defer></script>
<script src="<%- url_for('/js/code-line-numbers.js') %>" defer></script>
<script src="<%- url_for('/js/image-lazy-loading.js') %>" defer></script>
<script src="<%- url_for('/js/font-size-toggle.js') %>" defer></script>
<script src="<%- url_for('/js/code-copy.js') %>" defer></script>
<script src="<%- url_for('/js/code-collapse.js') %>" defer></script>
<script src="<%- url_for('/js/print-button.js') %>" defer></script>
<script src="<%- url_for('/js/article-title-double-click-copy.js') %>" defer></script>
<script src="<%- url_for('/js/quote-copy.js') %>" defer></script>
<script src="<%- url_for('/js/relative-time-display.js') %>" defer></script>
<script type="module">
  import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs";

  const directBlocks = Array.from(document.querySelectorAll("pre > code.language-mermaid"));
  const hexoBlocks = Array.from(document.querySelectorAll("figure.highlight.plaintext"));
  const mermaidLeadings = [
    "flowchart",
    "graph",
    "sequenceDiagram",
    "classDiagram",
    "stateDiagram",
    "erDiagram",
    "journey",
    "gantt",
    "pie",
    "mindmap",
    "timeline"
  ];

  const blocks = [...directBlocks];

  hexoBlocks.forEach((figure) => {
    const lines = Array.from(figure.querySelectorAll(".line"))
      .map((line) => line.textContent || "")
      .join("\n")
      .trim();

    if (!lines) return;
    if (!mermaidLeadings.some((prefix) => lines.startsWith(prefix))) return;

    blocks.push({
      isHexoFigure: true,
      source: lines,
      element: figure
    });
  });

  blocks.forEach((block, index) => {
    const container = document.createElement("div");
    container.className = "mermaid";
    container.id = `mermaid-diagram-${index}`;
    if (block.isHexoFigure) {
      container.textContent = block.source;
      block.element.parentElement?.replaceChild(container, block.element);
      return;
    }

    const pre = block.parentElement;
    if (!pre || !pre.parentElement) return;
    container.textContent = block.textContent || "";
    pre.parentElement.replaceChild(container, pre);
  });

  if (blocks.length > 0) {
    // Render Mermaid with theme sync (light/dark) and auto re-render on theme toggle.
    await window.MermaidEnhance?.initMermaidEnhance?.({ mermaid });
  }

  window.RelativeTimeDisplay?.initRelativeTimeDisplay?.();
  window.CodeCopy?.initCodeCopy();
  window.CodeCollapse?.initCodeCollapse();
  window.Breadcrumb?.initBreadcrumb?.();
  window.TocScrollSpy?.initTocScrollSpy();
  window.ReadingProgress?.initReadingProgress();
  window.ReadingTimeCountdown?.init();
  window.HeadingAnchorCopy?.initHeadingAnchorCopy();
  window.ArticleLinkCopy?.initArticleLinkCopy();
  window.PostLike?.initPostLike();
  window.PostBookmarkUI?.initPostBookmark?.();
  window.ImageOpen?.initImageOpen?.();
  window.CodeLanguageLabel?.initCodeLanguageLabel();
  window.CodeLineNumbers?.initCodeLineNumbers();
  window.ImageLazyLoading?.initImageLazyLoading?.();
  window.PrintButton?.initPrintButton?.();
  window.ArticleTitleDoubleClickCopy?.init();
  window.ArticleTitleDoubleClickCopy?.init();
</script>
