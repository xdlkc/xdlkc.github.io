<%
const newsItems = (typeof news_sorted === 'function' ? news_sorted() : []);
const format = (iso) => {
  if (!iso) return '';
  const d = new Date(iso);
  return Number.isFinite(d.getTime())
    ? d.toLocaleString('zh-CN', { hour12: false, timeZone: 'Asia/Shanghai' })
    : String(iso);
};
const normalizeTags = (region) => {
  if (!region) return [];
  const arr = Array.isArray(region) ? region : (typeof region === 'string' ? [region] : []);
  const seen = new Set();
  const out = [];
  arr.forEach((t) => {
    const raw = String(t || '').trim();
    if (!raw) return;
    const v = raw.toUpperCase();
    let label = raw;
    if (v === 'INT' || v === 'INTERNATIONAL') label = '国际';
    else if (v === 'CN' || v === 'DOMESTIC') label = '国内';
    if (!seen.has(label)) {
      seen.add(label);
      out.push(label);
    }
  });
  return out;
};

const normalizedItems = newsItems.map((n) => ({
  item: n,
  tags: normalizeTags(n.region || n.tags)
}));

const tagCounts = new Map();
normalizedItems.forEach(({ tags }) => {
  tags.forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});

const sortedTags = Array.from(tagCounts.entries()).sort((a, b) => {
  if (b[1] !== a[1]) return b[1] - a[1];
  return a[0].localeCompare(b[0], 'zh-CN');
});
%>

<link rel="stylesheet" href="<%- url_for('/css/news-filter.css') %>" />

<article class="article-shell container">
  <%- partial('_partial/header', { navClass: 'article-nav', activeSection: 'news' }) %>

  <header class="article-hero">
    <p class="tag" data-i18n-key="news.flash">Flash</p>
    <h1><%= page.title || 'News Board' %></h1>
  </header>

  <main id="main-content" class="article-card" tabindex="-1">
    <% if (!normalizedItems.length) { %>
      <p data-i18n-key="news.empty">No news data yet. Add items to source/_data/news.json.</p>
    <% } else { %>
      <div class="article-content">
        <div class="news-filter-bar" role="region" aria-label="Filter news by tag" data-news-filter-bar>
          <div class="news-filter-chips" role="group" aria-label="News category filters">
            <button
              type="button"
              class="news-filter-chip is-active"
              data-news-filter-chip="all"
              aria-pressed="true"
            >
              <span class="news-filter-chip-label" data-news-i18n="all">All</span>
              <span class="news-filter-chip-count"><%= normalizedItems.length %></span>
            </button>
            <% sortedTags.forEach(([tag, count]) => { %>
              <button
                type="button"
                class="news-filter-chip"
                data-news-filter-chip="<%= tag %>"
                aria-pressed="false"
              >
                <span class="news-filter-chip-label">#<%= tag %></span>
                <span class="news-filter-chip-count"><%= count %></span>
              </button>
            <% }) %>
          </div>
          <p class="news-filter-status" data-news-filter-status aria-live="polite"></p>
        </div>

        <div class="news-feed" data-news-feed data-news-page-size="15">
          <% normalizedItems.forEach(({ item: n, tags }) => { %>
            <section class="news-item" data-news-item data-news-tags="<%= tags.join('|') %>">
              <h2 class="news-item-title">
                <a href="<%= n.url %>" target="_blank" rel="noreferrer"><%= n.title %></a>
              </h2>
              <div class="news-item-meta">
                <span><%= format(n.publishedAt) %></span>
                <% if (n.source) { %>
                  <span> · <%= n.source %></span>
                <% } %>
              </div>
              <% const summaryText = (n.summary && String(n.summary).trim()) || ''; %>
              <% const contextText = (n.context && String(n.context).trim()) || ''; %>
              <% if (summaryText) { %>
                <p class="news-item-summary"><%= summaryText %></p>
              <% } %>
              <% if (contextText) { %>
                <p class="news-item-context"><span data-i18n-key="news.context">Context:</span> <%= contextText %></p>
              <% } %>
              <% if (tags.length) { %>
                <div class="news-item-tags">
                  <% tags.forEach((t) => { %>
                    <button
                      type="button"
                      class="news-tag-badge"
                      data-news-tag-badge="<%= t %>"
                      aria-pressed="false"
                    >#<%= t %></button>
                  <% }) %>
                </div>
              <% } %>
            </section>
          <% }) %>
        </div>

        <div class="news-pagination" data-news-pagination hidden>
          <button type="button" class="news-load-more-btn" data-news-load-more>
            Load more
          </button>
        </div>
      </div>
    <% } %>
  </main>
</article>

<script src="<%- url_for('/js/news-filter.js') %>" defer></script>
