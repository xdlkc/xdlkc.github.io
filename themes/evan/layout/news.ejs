<%
const newsItems = (typeof news_sorted === 'function' ? news_sorted() : []);
const format = (iso) => {
  if (!iso) return '';
  const d = new Date(iso);
  return Number.isFinite(d.getTime())
    ? d.toLocaleString('zh-CN', { hour12: false, timeZone: 'Asia/Shanghai' })
    : String(iso);
};
const normalizeTags = (region) => {
  if (!region) return [];
  const arr = Array.isArray(region) ? region : (typeof region === 'string' ? [region] : []);
  return arr.map((t) => {
    const v = String(t).toUpperCase();
    if (v === 'INT') return '国际';
    if (v === 'CN') return '国内';
    return String(t);
  });
};
%>

<article class="article-shell container">
  <nav class="article-nav">
    <a class="brand" href="<%- url_for('/') %>"><%= config.title %></a>
    <div class="nav-links">
      <a href="<%- url_for('/archives/') %>" data-i18n-key="nav.archives">Archives</a>
      <a href="<%- url_for('/news/') %>" data-i18n-key="nav.news">News</a>
      <a href="<%- url_for('/rss.xml') %>" aria-label="RSS">RSS</a>
      <button class="site-search-trigger" data-site-search-trigger data-i18n-key="nav.search" data-i18n-aria-label-key="nav.search" aria-label="Search">Search</button>
      <button class="theme-toggle" data-theme-toggle data-i18n-key="nav.theme" data-i18n-aria-label-key="nav.theme" aria-pressed="false" aria-label="Theme">Theme</button>
      <button class="lang-toggle" data-lang-toggle data-i18n-key="nav.lang" aria-label="切换为中文">中文</button>
    </div>
  </nav>

  <header class="article-hero">
    <p class="tag" data-i18n-key="news.flash">Flash</p>
    <h1><%= page.title || 'News Board' %></h1>
  </header>

  <main id="main-content" class="article-card" tabindex="-1">
    <% if (!newsItems.length) { %>
      <p data-i18n-key="news.empty">No news data yet. Add items to source/_data/news.json.</p>
    <% } else { %>
      <div class="article-content">
        <% newsItems.forEach((n) => { %>
          <section style="margin: 1.2rem 0;">
            <h2 style="margin: 0 0 0.35rem 0; font-size: 1.05rem;">
              <a href="<%= n.url %>" target="_blank" rel="noreferrer"><%= n.title %></a>
            </h2>
            <div style="opacity: 0.75; font-size: 0.95rem;">
              <span><%= format(n.publishedAt) %></span>
              <% if (n.source) { %>
                <span> · <%= n.source %></span>
              <% } %>
            </div>
            <% const summaryText = (n.summary && String(n.summary).trim()) || ''; %>
            <% const contextText = (n.context && String(n.context).trim()) || ''; %>
            <% if (summaryText) { %>
              <p style="margin: 0.4rem 0 0 0;"><%= summaryText %></p>
            <% } %>
            <% if (contextText) { %>
              <p style="margin: 0.35rem 0 0 0; opacity: 0.82;"><span data-i18n-key="news.context">Context:</span> <%= contextText %></p>
            <% } %>
            <% const tags = normalizeTags(n.region || n.tags); if (tags.length) { %>
              <p style="margin: 0.35rem 0 0 0; opacity: 0.75;">
                <% tags.forEach((t) => { %>
                  <code style="margin-right: 0.4rem;">#<%= t %></code>
                <% }) %>
              </p>
            <% } %>
          </section>
          <hr />
        <% }) %>
      </div>
    <% } %>
  </main>
</article>
