<%
const newsItems = (typeof news_sorted === 'function' ? news_sorted() : []);
const format = (iso) => {
  if (!iso) return '';
  const d = new Date(iso);
  if (!Number.isFinite(d.getTime())) return String(iso);
  const parts = new Intl.DateTimeFormat('zh-CN', {
    timeZone: 'Asia/Shanghai',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  }).formatToParts(d);
  const get = (type) => (parts.find((p) => p.type === type) || {}).value || '';
  return `${get('year')}-${get('month')}-${get('day')} ${get('hour')}:${get('minute')}`;
};

const normalizeTagLabel = (raw) => {
  const clean = String(raw || '').trim();
  if (!clean) return '';
  const v = clean.toUpperCase();
  if (v === 'INT' || v === 'INTERNATIONAL') return '国际';
  if (v === 'CN' || v === 'DOMESTIC') return '国内';
  return clean;
};

const toStringList = (val) => {
  if (!val) return [];
  if (Array.isArray(val)) return val;
  if (typeof val === 'string') return [val];
  return [];
};

const normalizeTags = (region, topics, fallbackTags) => {
  const combined = [...toStringList(region), ...toStringList(topics)];
  const sourceList = combined.length ? combined : toStringList(fallbackTags);
  const seen = new Set();
  const out = [];
  sourceList.forEach((t) => {
    const label = normalizeTagLabel(t);
    if (label && !seen.has(label)) {
      seen.add(label);
      out.push(label);
    }
  });
  return out;
};

const inferIndustry = (item, tags) => {
  if (item && typeof item.industry === 'string' && item.industry.trim()) {
    return item.industry.trim();
  }
  const id = String((item && item.id) || '');
  if (id.startsWith('aihot-') || (Array.isArray(tags) && tags.includes('AI精选'))) {
    return 'AI';
  }
  return '金融与政策';
};

const normalizedItems = newsItems.map((n, idx) => {
  const tags = normalizeTags(n.region, n.topics, n.tags);
  const industry = inferIndustry(n, tags);
  const selected = n && n.selected !== false;
  const detailUrl = typeof news_detail_path === 'function' ? url_for(news_detail_path(n, idx)) : n.url;
  return {
    item: n,
    tags,
    industry,
    selected,
    detailUrl,
    idx
  };
});

const detailUrlById = new Map();
normalizedItems.forEach(({ item, detailUrl }) => {
  if (item && item.id) {
    detailUrlById.set(String(item.id), detailUrl);
  }
});

const resolveItemDetailUrl = (sub, fallbackIdx = 0) => {
  if (sub && sub.id && detailUrlById.has(String(sub.id))) {
    return detailUrlById.get(String(sub.id));
  }
  if (sub && sub.id && typeof news_detail_path === 'function') {
    return url_for(news_detail_path(sub, fallbackIdx));
  }
  return (sub && sub.url) || '#';
};

const curatedItems = normalizedItems.filter((x) => x.selected);

// Build hot events from site.data['news-hot'], with a clean fallback from top ranked newsItems
const rawHotEvents = (site && site.data && Array.isArray(site.data['news-hot'])) ? site.data['news-hot'] : [];
let hotEvents = [];

if (rawHotEvents.length) {
  hotEvents = rawHotEvents.map((ev, idx) => {
    const evTopics = normalizeTags(ev.region, ev.topics, ev.tags);
    const evIndustry = inferIndustry(ev, evTopics);
    const subItems = Array.isArray(ev.items) ? ev.items.map((sub, sIdx) => ({
      id: sub.id || '',
      title: sub.title || '',
      source: sub.source || '',
      publishedAt: sub.publishedAt || '',
      url: sub.url || '',
      score: typeof sub.score === 'number' && Number.isFinite(sub.score) ? Math.round(sub.score) : null,
      detailUrl: resolveItemDetailUrl(sub, sIdx)
    })) : [];
    const primaryItem = subItems[0] || null;
    const uniqueSources = new Set(subItems.map((s) => s.source).filter(Boolean));
    const sourceCount = typeof ev.sourceCount === 'number' && ev.sourceCount > 0
      ? Math.round(ev.sourceCount)
      : Math.max(1, uniqueSources.size || subItems.length);
    const heatScore = typeof ev.heatScore === 'number' && Number.isFinite(ev.heatScore)
      ? Math.round(ev.heatScore)
      : (primaryItem && primaryItem.score !== null ? primaryItem.score : Math.max(50, 95 - idx * 3));
    return {
      id: ev.id || `hot-${idx + 1}`,
      rank: typeof ev.rank === 'number' && ev.rank > 0 ? Math.round(ev.rank) : (idx + 1),
      title: ev.title || (primaryItem && primaryItem.title) || '',
      industry: evIndustry,
      topics: evTopics,
      heatScore,
      sourceCount,
      latestAt: ev.latestAt || (primaryItem && primaryItem.publishedAt) || '',
      summary: (ev.summary && String(ev.summary).trim()) || '',
      primaryDetailUrl: (primaryItem && primaryItem.detailUrl) || resolveItemDetailUrl(ev, idx),
      primaryExtUrl: (primaryItem && primaryItem.url) || ev.url || '',
      items: subItems
    };
  });
} else if (normalizedItems.length) {
  const ranked = normalizedItems.slice().sort((a, b) => {
    const scoreA = typeof a.item.score === 'number' && Number.isFinite(a.item.score) ? a.item.score : 50;
    const scoreB = typeof b.item.score === 'number' && Number.isFinite(b.item.score) ? b.item.score : 50;
    if (scoreB !== scoreA) return scoreB - scoreA;
    const timeA = new Date(a.item.publishedAt || 0).getTime() || 0;
    const timeB = new Date(b.item.publishedAt || 0).getTime() || 0;
    return timeB - timeA;
  }).slice(0, 12);

  hotEvents = ranked.map(({ item: n, tags, industry, detailUrl }, idx) => {
    const scoreNum = typeof n.score === 'number' && Number.isFinite(n.score) ? Math.round(n.score) : null;
    const heatScore = scoreNum !== null ? scoreNum : Math.max(55, 88 - idx * 3);
    return {
      id: n.id || `hot-fallback-${idx + 1}`,
      rank: idx + 1,
      title: n.title || '',
      industry,
      topics: tags,
      heatScore,
      sourceCount: 1,
      latestAt: n.publishedAt || '',
      summary: (n.summary && String(n.summary).trim()) || (n.context && String(n.context).trim()) || '',
      primaryDetailUrl: detailUrl,
      primaryExtUrl: n.url || '',
      items: [{
        id: n.id || '',
        title: n.title || '',
        source: n.source || '',
        publishedAt: n.publishedAt || '',
        url: n.url || '',
        score: scoreNum,
        detailUrl
      }]
    };
  });
}

// Canonical industries order
const canonicalIndustries = ['AI', '工程与开源', '金融与政策'];
const industryList = canonicalIndustries.slice();
normalizedItems.forEach(({ industry }) => {
  if (industry && !industryList.includes(industry)) {
    industryList.push(industry);
  }
});

// Initial industry counts (default curated view)
const initialIndustryCounts = new Map();
industryList.forEach((ind) => initialIndustryCounts.set(ind, 0));
curatedItems.forEach(({ industry }) => {
  initialIndustryCounts.set(industry, (initialIndustryCounts.get(industry) || 0) + 1);
});

// Collect all topic/tag labels across all items so switching to "all" or "hot" has chips ready
const allTagCounts = new Map();
normalizedItems.forEach(({ tags }) => {
  tags.forEach((tag) => {
    allTagCounts.set(tag, (allTagCounts.get(tag) || 0) + 1);
  });
});

// Initial tag counts for the default curated view
const curatedTagCounts = new Map();
curatedItems.forEach(({ tags }) => {
  tags.forEach((tag) => {
    curatedTagCounts.set(tag, (curatedTagCounts.get(tag) || 0) + 1);
  });
});

const sortedTags = Array.from(allTagCounts.entries())
  .sort((a, b) => {
    if (a[0] === 'AI精选') return -1;
    if (b[0] === 'AI精选') return 1;
    if (b[1] !== a[1]) return b[1] - a[1];
    return a[0].localeCompare(b[0], 'zh-CN');
  })
  .map(([tag]) => [tag, curatedTagCounts.get(tag) || 0]);
%>

<link rel="stylesheet" href="<%- url_for('/css/news-filter.css') %>" />

<article class="article-shell news-shell container">
  <%- partial('_partial/header', { navClass: 'article-nav', activeSection: 'news' }) %>

  <header class="news-hero">
    <p class="tag" data-i18n-key="news.flash">Flash</p>
    <h1><%= page.title || 'News Board' %></h1>
  </header>

  <main id="main-content" class="news-board" tabindex="-1">
    <% if (!normalizedItems.length) { %>
      <div class="news-empty-card">
        <p data-i18n-key="news.empty">No news data yet. Add items to source/_data/news.json.</p>
      </div>
    <% } else { %>
      <!-- Primary 3-View Switcher -->
      <nav class="news-view-tabs" role="tablist" aria-label="News views" data-news-view-tabs>
        <button
          type="button"
          role="tab"
          class="news-view-tab is-active"
          data-news-view-tab="curated"
          aria-selected="true"
        >
          <span class="news-view-tab-icon" aria-hidden="true">⚡</span>
          <span class="news-view-tab-label" data-news-i18n="viewCurated">精选</span>
          <span class="news-view-tab-count" data-news-view-count="curated"><%= curatedItems.length %></span>
        </button>
        <button
          type="button"
          role="tab"
          class="news-view-tab"
          data-news-view-tab="all"
          aria-selected="false"
        >
          <span class="news-view-tab-icon" aria-hidden="true">☰</span>
          <span class="news-view-tab-label" data-news-i18n="viewAll">全部动态</span>
          <span class="news-view-tab-count" data-news-view-count="all"><%= normalizedItems.length %></span>
        </button>
        <button
          type="button"
          role="tab"
          class="news-view-tab"
          data-news-view-tab="hot"
          aria-selected="false"
        >
          <span class="news-view-tab-icon" aria-hidden="true">🔥</span>
          <span class="news-view-tab-label" data-news-i18n="viewHot">热点榜</span>
          <span class="news-view-tab-count" data-news-view-count="hot"><%= hotEvents.length %></span>
        </button>
      </nav>

      <!-- 2-Level Filter Bar (Industry + Topic/Tag) -->
      <div class="news-filter-bar" role="region" aria-label="Filter news by tag" data-news-filter-bar>
        <div class="news-industry-bar" role="group" aria-label="Filter news by industry" data-news-industry-bar>
          <button
            type="button"
            class="news-industry-chip is-active"
            data-news-industry-chip="all"
            aria-pressed="true"
          >
            <span class="news-industry-chip-label" data-news-i18n="industryAll">全部行业</span>
            <span class="news-industry-chip-count" data-news-industry-count="all"><%= curatedItems.length %></span>
          </button>
          <% industryList.forEach((ind) => { %>
            <button
              type="button"
              class="news-industry-chip"
              data-news-industry-chip="<%= ind %>"
              aria-pressed="false"
            >
              <span class="news-industry-chip-label" data-news-industry-label="<%= ind %>"><%= ind %></span>
              <span class="news-industry-chip-count" data-news-industry-count="<%= ind %>"><%= initialIndustryCounts.get(ind) || 0 %></span>
            </button>
          <% }) %>
        </div>

        <div class="news-topic-row">
          <div class="news-filter-chips" role="group" aria-label="News category filters">
            <button
              type="button"
              class="news-filter-chip is-active"
              data-news-filter-chip="all"
              aria-pressed="true"
            >
              <span class="news-filter-chip-label" data-news-i18n="all">All</span>
              <span class="news-filter-chip-count" data-news-tag-count="all"><%= curatedItems.length %></span>
            </button>
            <% sortedTags.forEach(([tag, count]) => { %>
              <button
                type="button"
                class="news-filter-chip"
                data-news-filter-chip="<%= tag %>"
                aria-pressed="false"
              >
                <span class="news-filter-chip-label">#<%= tag %></span>
                <span class="news-filter-chip-count" data-news-tag-count="<%= tag %>"><%= count %></span>
              </button>
            <% }) %>
          </div>
          <p class="news-filter-status" data-news-filter-status aria-live="polite"></p>
        </div>
      </div>

      <!-- Curated / All News Feed -->
      <div class="news-feed" data-news-feed data-news-page-size="15">
        <% normalizedItems.forEach(({ item: n, tags, industry, selected, detailUrl }) => {
          const scoreNum = typeof n.score === 'number' && Number.isFinite(n.score) ? Math.round(n.score) : null;
          const summaryText = (n.summary && String(n.summary).trim()) || '';
          const contextText = (n.context && String(n.context).trim()) || '';
        %>
          <section
            class="news-item"
            data-news-item
            data-news-selected="<%= selected ? 'true' : 'false' %>"
            data-news-industry="<%= industry %>"
            data-news-tags="<%= tags.join('|') %>"
          >
            <div class="news-item-top">
              <div class="news-item-meta">
                <span class="news-industry-pill" data-news-industry-pill="<%= industry %>"><%= industry %></span>
                <% if (n.source) { %>
                  <span class="news-item-source"><%= n.source %></span>
                  <span class="news-item-sep" aria-hidden="true">·</span>
                <% } %>
                <time class="news-item-time" datetime="<%= n.publishedAt || '' %>"><%= format(n.publishedAt) %></time>
              </div>
              <div class="news-item-indicators">
                <% if (scoreNum !== null) { %>
                  <span class="news-score-badge<%= scoreNum >= 80 ? ' is-high' : '' %>" title="AIHOT curated score">★ <%= scoreNum %></span>
                <% } %>
                <a class="news-item-ext" href="<%= n.url %>" target="_blank" rel="noreferrer" aria-label="Open original article">↗</a>
              </div>
            </div>

            <h2 class="news-item-title">
              <a href="<%= detailUrl %>"><%= n.title %></a>
            </h2>

            <% if (summaryText) { %>
              <p class="news-item-summary"><%= summaryText %></p>
            <% } %>

            <% if (contextText) { %>
              <p class="news-item-context"><span class="news-context-label" data-i18n-key="news.context">Context:</span> <%= contextText %></p>
            <% } %>

            <% if (tags.length) { %>
              <div class="news-item-tags">
                <% tags.forEach((t) => { %>
                  <button
                    type="button"
                    class="news-tag-badge"
                    data-news-tag-badge="<%= t %>"
                    aria-pressed="false"
                  >#<%= t %></button>
                <% }) %>
              </div>
            <% } %>
          </section>
        <% }) %>
      </div>

      <!-- Hot Events Ranked Feed -->
      <div class="news-hot-feed" data-news-hot-feed hidden>
        <% hotEvents.forEach((ev) => { %>
          <article
            class="news-hot-card<%= ev.rank <= 3 ? ' is-top-rank' : '' %>"
            data-news-hot-item
            data-news-industry="<%= ev.industry %>"
            data-news-tags="<%= ev.topics.join('|') %>"
          >
            <div class="news-hot-top">
              <div class="news-hot-badges">
                <span class="news-hot-rank<%= ev.rank <= 3 ? ' is-top' : '' %>">#<%= ev.rank %></span>
                <span class="news-hot-heat">
                  <span aria-hidden="true">🔥</span>
                  <span data-news-i18n="heat">热度</span>
                  <strong><%= ev.heatScore %></strong>
                </span>
                <span class="news-hot-sources" data-news-i18n="sources" data-count="<%= ev.sourceCount %>"><%= ev.sourceCount %> 家来源报道</span>
              </div>
              <div class="news-hot-meta-right">
                <% if (ev.latestAt) { %>
                  <time class="news-item-time" datetime="<%= ev.latestAt %>"><%= format(ev.latestAt) %></time>
                <% } %>
                <% if (ev.primaryExtUrl) { %>
                  <a class="news-item-ext" href="<%= ev.primaryExtUrl %>" target="_blank" rel="noreferrer" aria-label="Open original article">↗</a>
                <% } %>
              </div>
            </div>

            <h2 class="news-hot-title">
              <a href="<%= ev.primaryDetailUrl %>"><%= ev.title %></a>
            </h2>

            <% if (ev.summary) { %>
              <p class="news-hot-summary"><%= ev.summary %></p>
            <% } %>

            <div class="news-hot-footer">
              <div class="news-hot-tags">
                <span class="news-industry-pill" data-news-industry-pill="<%= ev.industry %>"><%= ev.industry %></span>
                <% ev.topics.forEach((t) => { %>
                  <button
                    type="button"
                    class="news-tag-badge"
                    data-news-tag-badge="<%= t %>"
                    aria-pressed="false"
                  >#<%= t %></button>
                <% }) %>
              </div>
              <a class="news-hot-detail-link" href="<%= ev.primaryDetailUrl %>" data-news-i18n="viewDetail">查看详情 →</a>
            </div>

            <% if (ev.items.length > 1) { %>
              <details class="news-hot-related" data-news-hot-related>
                <summary class="news-hot-related-summary" data-news-i18n="relatedCoverage" data-count="<%= ev.items.length %>">
                  相关报道（<%= ev.items.length %> 篇）
                </summary>
                <ul class="news-hot-related-list">
                  <% ev.items.forEach((sub) => { %>
                    <li class="news-hot-related-item">
                      <a class="news-hot-related-title" href="<%= sub.detailUrl %>"><%= sub.title %></a>
                      <div class="news-hot-related-meta">
                        <% if (sub.source) { %>
                          <span class="news-item-source"><%= sub.source %></span>
                        <% } %>
                        <% if (sub.publishedAt) { %>
                          <time class="news-item-time" datetime="<%= sub.publishedAt %>"><%= format(sub.publishedAt) %></time>
                        <% } %>
                        <% if (sub.url) { %>
                          <a class="news-item-ext" href="<%= sub.url %>" target="_blank" rel="noreferrer" aria-label="Open original article">↗</a>
                        <% } %>
                      </div>
                    </li>
                  <% }) %>
                </ul>
              </details>
            <% } %>
          </article>
        <% }) %>
      </div>

      <!-- Empty Filter State -->
      <div class="news-empty-card news-filter-empty" data-news-filter-empty hidden>
        <p data-news-i18n="emptyFiltered">当前筛选条件下暂无快讯。</p>
        <button type="button" class="news-reset-btn" data-news-reset-filters data-news-i18n="resetFilters">重置筛选</button>
      </div>

      <div class="news-pagination" data-news-pagination hidden>
        <button type="button" class="news-load-more-btn" data-news-load-more>
          Load more
        </button>
      </div>
    <% } %>
  </main>
</article>

<script src="<%- url_for('/js/news-filter.js') %>" defer></script>
