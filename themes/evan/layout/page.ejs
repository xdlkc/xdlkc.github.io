<% const pageToc = toc(page.content, { class: 'toc-nav', max_depth: 3, list_number: false }); %>
<% const hasPageToc = Boolean(pageToc && pageToc.trim()); %>
<article class="article-shell container<%= hasPageToc ? '' : ' page-shell-single' %>">
  <div class="reading-progress" data-reading-minutes="<%= reading_time(page.content) %>" role="progressbar" tabindex="0" aria-label="阅读进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
    <div class="reading-progress-bar"></div>
  </div>

  <%- partial('_partial/header', { navClass: 'article-nav' }) %>

  <header class="section-page-hero">
    <p class="tag"><%= (page.path && String(page.path).startsWith('about')) ? 'ABOUT' : 'PAGE' %></p>
    <div class="section-page-hero-row">
      <div>
        <h1><%= page.title %></h1>
      </div>
    </div>
  </header>

  <div class="article-layout<%= hasPageToc ? '' : ' article-layout-single' %>">
    <main id="main-content" class="article-card" tabindex="-1">
      <% if (pageToc && pageToc.trim()) { %>
        <details class="toc-mobile">
          <summary data-i18n-key="post.toc">Outline</summary>
          <div class="toc-mobile-body">
            <%- pageToc %>
          </div>
        </details>
      <% } %>

      <article class="article-content"><%- page.content %></article>
    </main>

    <% if (pageToc && pageToc.trim()) { %>
      <aside class="toc-card">
        <div class="toc-header">
          <p class="toc-title" data-i18n-key="post.outline">Outline</p>
          <button class="toc-visibility-toggle" type="button" data-toc-visibility-toggle aria-label="隐藏目录" aria-pressed="false">Hide</button>
        </div>
        <%- pageToc %>
      </aside>
    <% } %>
  </div>
</article>

<script src="<%- url_for('/js/heading-auto-id.js') %>" defer></script>
<script src="<%- url_for('/js/toc-scrollspy.js') %>" defer></script>
<script src="<%- url_for('/js/heading-anchor-copy.js') %>" defer></script>
<script src="<%- url_for('/js/reading-progress.js') %>" defer></script>
<script>
  window.addEventListener('DOMContentLoaded', function() {
    window.TocScrollSpy?.initTocScrollSpy();
    window.HeadingAnchorCopy?.initHeadingAnchorCopy?.();
    window.ReadingProgress?.initReadingProgress?.();
  });
</script>
