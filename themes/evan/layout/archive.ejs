<%
const posts = site.posts.sort('date', -1).toArray();
const grouped = {};
posts.forEach((post) => {
  const year = date(post.date, 'YYYY');
  grouped[year] = grouped[year] || [];
  grouped[year].push(post);
});
const years = Object.keys(grouped).sort((a, b) => Number(b) - Number(a));
%>
<div class="archive-shell container">
  <nav class="article-nav">
    <a class="brand" href="<%- url_for('/') %>"><%= config.title %></a>
    <div class="nav-links">
      <a href="<%- url_for('/about/') %>" data-i18n-key="nav.about">About</a>
      <a href="<%- url_for('/rss.xml') %>" aria-label="RSS">RSS</a>
      <button class="site-search-trigger" data-site-search-trigger data-i18n-key="nav.search" data-i18n-aria-label-key="nav.search" aria-label="Search">Search</button>
      <button class="theme-toggle" data-theme-toggle data-i18n-key="nav.theme" data-i18n-aria-label-key="nav.theme" aria-pressed="false" aria-label="Theme">Theme</button>
      <button class="lang-toggle" data-lang-toggle data-i18n-key="nav.lang" aria-label="切换为中文">中文</button>
    </div>
  </nav>

  <section class="archive-card">
    <h1 data-i18n-key="nav.archives">Archives</h1>
    <p class="archive-total"><span data-i18n-key="archive.totalPrefix">Total</span> <%= posts.length %> <span data-i18n-key="archive.totalSuffix">posts.</span></p>

    <% years.forEach((year) => { %>
      <div class="archive-year">
        <h2><%= year %></h2>
        <div class="archive-items-list">
          <% grouped[year].forEach((post) => { %>
            <article class="archive-item">
              <time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'MM-DD') %></time>
              <a href="<%- url_for(post.path) %>"><%= post.title %></a>
            </article>
          <% }) %>
        </div>
      </div>
    <% }) %>

    <%- partial('_partial/hot-tags-cloud') %>
  </section>

  <script src="<%- url_for('/js/archive-year-collapsible.js') %>" defer></script>
</div>
