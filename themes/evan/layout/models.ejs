<%
const modelsData = (page && page.modelsData) || {
  benchmarks: [],
  domains: [],
  overview: [],
  ranked: [],
  unranked: [],
  paretoFrontier: [],
  providers: [],
  usdToCny: 7.25,
  priceSource: 'OpenRouter',
  priceSourceUrl: 'https://openrouter.ai/api/v1/models',
  totalBenchmarks: 0,
  totalModels: 0,
  rankedCount: 0,
  unrankedCount: 0,
  latestUpdatedAt: ''
};
const safeJson = JSON.stringify(modelsData).replace(/</g, '\\u003c');
const rate = Number(modelsData.usdToCny) || 7.25;
const fmtCny = (usd) => {
  if (usd === null || usd === undefined || !Number.isFinite(Number(usd))) return '—';
  const v = Number(usd) * rate;
  return `¥${v < 1 ? v.toFixed(2) : v < 10 ? v.toFixed(2) : v.toFixed(1)}`;
};
%>

<link rel="stylesheet" href="<%- url_for('/css/models-board.css') %>" />

<article class="article-shell models-shell container">
  <%- partial('_partial/header', { navClass: 'article-nav', activeSection: 'models' }) %>

  <header class="models-hero">
    <p class="tag" data-i18n-key="models.tag">BENCHMARKS</p>
    <div class="models-hero-row">
      <div>
        <h1 data-i18n-key="models.title">Models Leaderboard</h1>
        <p class="models-hero-subtitle" data-i18n-key="models.subtitle">
          Cross-benchmark calibrated leaderboard with 5-domain weighting, live API pricing, and Pareto cost-performance frontier.
        </p>
      </div>
      <div class="models-hero-stats" aria-label="Leaderboard summary">
        <span class="models-stat-pill">
          <strong class="models-stat-num"><%= modelsData.totalBenchmarks %></strong>
          <span data-i18n-key="models.stats.benchmarks">Benchmarks</span>
        </span>
        <span class="models-stat-pill">
          <strong class="models-stat-num"><%= modelsData.rankedCount || modelsData.totalModels %></strong>
          <span data-i18n-key="models.stats.ranked">Ranked</span>
        </span>
        <% if (modelsData.latestUpdatedAt) { %>
          <span class="models-stat-pill">
            <span data-i18n-key="models.stats.updated">Updated</span>
            <strong class="models-stat-num"><%= modelsData.latestUpdatedAt %></strong>
          </span>
        <% } %>
      </div>
    </div>
  </header>

  <main id="main-content" class="models-board" tabindex="-1" data-models-board>
    <% if (!modelsData.benchmarks.length) { %>
      <div class="models-empty-card">
        <p data-i18n-key="models.noData">No benchmarks found. Drop a JSON file into source/_data/benchmarks/ to get started.</p>
      </div>
    <% } else { %>
      <!-- Primary View Switcher + Currency Toggle -->
      <section class="models-view-bar" aria-label="View mode and currency">
        <div class="models-view-switcher" role="tablist" aria-label="View mode" data-models-views>
          <button type="button" role="tab" class="models-view-btn is-active" data-models-view="leaderboard" aria-selected="true" data-i18n-key="models.view.leaderboard">
            Leaderboard
          </button>
          <button type="button" role="tab" class="models-view-btn" data-models-view="pricing" aria-selected="false" data-i18n-key="models.view.pricing">
            Pricing &amp; Context
          </button>
          <button type="button" role="tab" class="models-view-btn" data-models-view="frontier" aria-selected="false" data-i18n-key="models.view.frontier">
            Value Frontier
          </button>
        </div>

        <div class="models-currency-wrap">
          <span class="models-currency-label" data-i18n-key="models.currency.label">Currency</span>
          <div class="models-currency-toggle" role="group" aria-label="Currency toggle" data-models-currency-group>
            <button type="button" class="models-currency-btn is-active" data-models-currency="cny" aria-pressed="true">¥ RMB</button>
            <button type="button" class="models-currency-btn" data-models-currency="usd" aria-pressed="false">$ USD</button>
          </div>
        </div>
      </section>

      <!-- Domain + Benchmark Tabs (visible in Leaderboard view) -->
      <div class="models-tabs-stack" data-models-tabs-wrap>
        <div class="models-tabs" role="tablist" aria-label="Domains" data-models-tabs>
          <button
            type="button"
            role="tab"
            class="models-tab is-active"
            data-models-tab="overview"
            aria-selected="true"
          >
            <span class="models-tab-label" data-i18n-key="models.tab.overview">Composite</span>
            <span class="models-tab-count"><%= modelsData.totalBenchmarks %></span>
          </button>
          <% (modelsData.domains || []).forEach((dom) => { %>
            <button
              type="button"
              role="tab"
              class="models-tab"
              data-models-tab="domain:<%= dom.id %>"
              aria-selected="false"
            >
              <span class="models-tab-label" data-domain-label="<%= dom.id %>"><%= dom.labelZh %></span>
              <span class="models-tab-cat"><%= dom.weightPct %>%</span>
            </button>
          <% }) %>
        </div>

        <div class="models-bench-pills" role="tablist" aria-label="Individual benchmarks" data-models-bench-pills>
          <span class="models-bench-pills-label" data-i18n-key="models.benchmarks.single">Single Benchmark:</span>
          <% modelsData.benchmarks.forEach((bench) => { %>
            <button
              type="button"
              role="tab"
              class="models-bench-pill"
              data-models-tab="<%= bench.id %>"
              aria-selected="false"
            >
              <span><%= bench.name %></span>
            </button>
          <% }) %>
        </div>
      </div>

      <!-- Active Context Meta Strip -->
      <section class="models-meta-strip" data-models-meta aria-live="polite">
        <p class="models-meta-desc" data-models-meta-desc data-i18n-key="models.overview.desc">
          Difficulty-calibrated composite index (mean 50, SD 15) weighted across Coding (38%), Reasoning (19%), Professional (19%), Knowledge (14%), and Arena (10%).
        </p>
        <div class="models-meta-badges" data-models-meta-badges>
          <% if (modelsData.latestUpdatedAt) { %>
            <span class="models-meta-badge">
              <span data-i18n-key="models.meta.updated">Updated</span>: <%= modelsData.latestUpdatedAt %>
            </span>
          <% } %>
        </div>
      </section>

      <!-- Filter Toolbar -->
      <section class="models-toolbar" role="region" aria-label="Filter models" data-models-toolbar>
        <div class="models-filter-group" role="group" aria-label="Model filters">
          <button type="button" class="models-chip is-active" data-models-license="all" aria-pressed="true" data-i18n-key="models.filter.all">All</button>
          <button type="button" class="models-chip" data-models-license="open" aria-pressed="false" data-i18n-key="models.filter.open">Open Weights</button>
          <button type="button" class="models-chip" data-models-license="closed" aria-pressed="false" data-i18n-key="models.filter.closed">Closed API</button>
          <button type="button" class="models-chip models-chip-toggle" data-models-domestic aria-pressed="false" data-i18n-key="models.filter.domestic">Domestic (CN)</button>
          <button type="button" class="models-chip models-chip-toggle" data-models-reasoning aria-pressed="false" data-i18n-key="models.filter.reasoning">Reasoning</button>
        </div>

        <div class="models-controls-right">
          <select class="models-select" data-models-provider aria-label="Filter by provider">
            <option value="all" data-i18n-key="models.filter.providerAll">All Providers</option>
            <% modelsData.providers.forEach((provider) => { %>
              <option value="<%= provider %>"><%= provider %></option>
            <% }) %>
          </select>

          <input
            type="search"
            class="models-search"
            data-models-search
            data-i18n-placeholder-key="models.filter.searchPlaceholder"
            placeholder="Search model or provider…"
            aria-label="Search models"
            autocomplete="off"
          />

          <span class="models-status" data-models-status aria-live="polite">
            <%= modelsData.rankedCount || modelsData.totalModels %> / <%= modelsData.rankedCount || modelsData.totalModels %>
          </span>
        </div>
      </section>

      <!-- Main Table Card (Leaderboard & Pricing views) -->
      <section class="models-table-card" data-models-table-section>
        <div class="models-table-wrap">
          <table class="models-table" data-models-table>
            <thead data-models-thead>
              <tr>
                <th scope="col" class="col-rank" data-i18n-key="models.col.rank">#</th>
                <th scope="col" class="col-model" data-i18n-key="models.col.model">Model</th>
                <th scope="col" class="col-release" data-i18n-key="models.col.release">Release</th>
                <th scope="col" class="col-coverage" data-i18n-key="models.col.coverage">Coverage</th>
                <th scope="col" class="col-price" data-i18n-key="models.col.cachePrice">Cache</th>
                <th scope="col" class="col-price" data-i18n-key="models.col.inputPrice">Input</th>
                <th scope="col" class="col-price" data-i18n-key="models.col.outputPrice">Output</th>
                <th scope="col" class="col-composite" data-i18n-key="models.col.composite">Score</th>
              </tr>
            </thead>
            <tbody data-models-tbody>
              <% (modelsData.ranked.length ? modelsData.ranked : modelsData.overview).forEach((row, idx) => { %>
                <tr data-model-row="<%= row.model %>">
                  <td class="col-rank">
                    <span class="models-rank<%= idx < 3 ? ` is-top-${idx + 1}` : '' %>"><%= String(idx + 1).padStart(2, '0') %></span>
                  </td>
                  <td class="col-model">
                    <div class="models-model-cell">
                      <div class="models-model-head">
                        <span class="models-provider-badge" style="background:<%= row.providerBadge ? row.providerBadge.color : '#64748b' %>"><%= row.providerBadge ? row.providerBadge.code : 'AI' %></span>
                        <div class="models-model-title-wrap">
                          <a class="models-model-name" href="<%- url_for('/models/' + row.slug + '/') %>"><%= row.model %></a>
                          <div class="models-model-meta">
                            <span class="models-provider-label"><%= row.provider %></span>
                            <% if (row.openWeights) { %>
                              <span class="models-badge is-open">Open</span>
                            <% } %>
                            <% if (row.domestic) { %>
                              <span class="models-badge is-domestic">CN</span>
                            <% } %>
                          </div>
                        </div>
                      </div>
                    </div>
                  </td>
                  <td class="col-release"><span class="models-release-val"><%= row.releaseDate || '—' %></span></td>
                  <td class="col-coverage">
                    <div class="models-coverage-cell">
                      <span class="models-coverage-count"><%= row.benchCount %> / <%= modelsData.totalBenchmarks %></span>
                      <span class="models-coverage-pct"><%= row.coveragePct %>%</span>
                    </div>
                  </td>
                  <td class="col-price"><span class="models-price-val"><%= fmtCny(row.pricingUsd && row.pricingUsd.cacheRead) %></span></td>
                  <td class="col-price"><span class="models-price-val"><%= fmtCny(row.pricingUsd && row.pricingUsd.input) %></span></td>
                  <td class="col-price"><span class="models-price-val"><%= fmtCny(row.pricingUsd && row.pricingUsd.output) %></span></td>
                  <td class="col-composite">
                    <div class="models-bar-cell">
                      <span class="models-score-val is-primary"><%= row.compositeScore.toFixed(1) %></span>
                      <div class="models-bar-track" aria-hidden="true">
                        <div class="models-bar-fill" style="width: <%= Math.min(100, Math.max(0, row.compositeScore)) %>%"></div>
                      </div>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <div class="models-empty-state" data-models-empty hidden>
          <p data-i18n-key="models.empty">No models match the current filters.</p>
          <button type="button" class="models-reset-btn" data-models-reset data-i18n-key="models.filter.reset">Reset filters</button>
        </div>
      </section>

      <!-- Pareto Frontier View (hidden by default) -->
      <section class="models-frontier-section" data-models-frontier-section hidden>
        <div class="models-frontier-card">
          <div class="models-frontier-header">
            <div>
              <h2 data-i18n-key="models.frontier.title">Pareto Cost-Performance Frontier</h2>
              <p class="models-frontier-desc" data-i18n-key="models.frontier.desc">
                Log-scale 7:2:1 blended API cost (70% cached input + 20% input + 10% output) vs. calibrated composite score. Highlighted models form the optimal value frontier.
              </p>
            </div>
            <span class="models-meta-badge" data-models-frontier-unit>¥ / 百万 Token</span>
          </div>
          <div class="models-frontier-chart-wrap" data-models-frontier-chart></div>
        </div>

        <div class="models-frontier-steps-card">
          <h3 data-i18n-key="models.frontier.stepsTitle">Optimal Frontier Progression</h3>
          <div class="models-frontier-steps" data-models-frontier-steps></div>
        </div>
      </section>

      <!-- Calibration Notice + Collapsible Unranked Section -->
      <p class="models-calibration-note" data-models-calibration-note data-i18n-key="models.calibrationNote">
        Note: Score differences under 3 points are within cross-benchmark variance. Models with insufficient benchmark coverage are listed below under Unranked.
      </p>

      <% if (modelsData.unrankedCount > 0) { %>
        <details class="models-unranked-card" data-models-unranked-wrap>
          <summary class="models-unranked-summary">
            <span data-i18n-key="models.unranked.title">Unranked Models (Insufficient Coverage)</span>
            <span class="models-tab-count" data-models-unranked-count><%= modelsData.unrankedCount %></span>
          </summary>
          <div class="models-table-wrap">
            <table class="models-table models-table-compact">
              <thead>
                <tr>
                  <th scope="col" class="col-model" data-i18n-key="models.col.model">Model</th>
                  <th scope="col" class="col-coverage" data-i18n-key="models.col.coverage">Coverage</th>
                  <th scope="col" class="col-composite" data-i18n-key="models.col.composite">Reference Score</th>
                  <th scope="col" data-i18n-key="models.unranked.reason">Reason</th>
                </tr>
              </thead>
              <tbody data-models-unranked-tbody></tbody>
            </table>
          </div>
        </details>
      <% } %>
    <% } %>

    <details class="models-ext-card">
      <summary class="models-ext-summary">
        <span class="models-ext-icon" aria-hidden="true">+</span>
        <span data-i18n-key="models.guide.summary">How to add a new benchmark (1 file / 1 command)</span>
      </summary>
      <div class="models-ext-body">
        <p data-i18n-key="models.guide.lead">
          This leaderboard automatically discovers every *.json file under source/_data/benchmarks/ at build time and syncs live API pricing from OpenRouter.
        </p>
        <pre class="models-ext-code"><code># Option 1: Scaffold with 1 command
node tools/add-benchmark.js --id=pinchbench --name="PinchBench" --category="编程" --unit="%"

# Option 2: Sync live benchmark feeds &amp; OpenRouter pricing
node tools/sync-benchmarks.js</code></pre>
      </div>
    </details>
  </main>
</article>

<script id="models-board-data" type="application/json"><%- safeJson %></script>
<script src="<%- url_for('/js/models-board.js') %>" defer></script>
