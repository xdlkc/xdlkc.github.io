<% if (page && page.audio) { %>
  <% const audioData = typeof post_audio_data === 'function' ? post_audio_data(page) : null; %>
  <% const audioMode = (audioData && audioData.mode) || (page.audio_mode === 'full' ? 'full' : 'podcast'); %>
  <% const badgeI18nKey = audioMode === 'full' ? 'post.audio.full' : 'post.audio.podcast'; %>
  <% const badgeDefaultText = audioMode === 'full' ? 'Full Audio' : 'AI Audio Guide'; %>
  <% const initialDuration = (audioData && audioData.duration) || (page.audio_duration ? String(page.audio_duration) : '00:00'); %>
  <% const paragraphs = (audioData && Array.isArray(audioData.paragraphs)) ? audioData.paragraphs : []; %>
  <% const highlights = (audioData && Array.isArray(audioData.highlights)) ? audioData.highlights : []; %>
  <% const hasDrawer = paragraphs.length > 0 || highlights.length > 0; %>

  <section
    class="post-audio-player"
    data-post-audio-player
    data-audio-mode="<%= audioMode %>"
    <% if (audioData && audioData.totalSeconds) { %>data-audio-total-seconds="<%= audioData.totalSeconds %>"<% } %>
    aria-label="Article audio player"
  >
    <audio
      class="post-audio-element"
      data-audio-el
      preload="metadata"
      src="<%- url_for(page.audio) %>"
    ></audio>

    <div class="post-audio-console">
      <button
        type="button"
        class="post-audio-play-btn"
        data-audio-play
        aria-label="Play audio"
        aria-pressed="false"
      >
        <svg class="post-audio-icon-play" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path d="M8 5.14v13.72a1 1 0 0 0 1.52.85l11.02-6.86a1 1 0 0 0 0-1.7L9.52 4.29A1 1 0 0 0 8 5.14z"/>
        </svg>
        <svg class="post-audio-icon-pause" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
          <rect x="6" y="5" width="4.2" height="14" rx="1.3"/>
          <rect x="13.8" y="5" width="4.2" height="14" rx="1.3"/>
        </svg>
      </button>

      <div class="post-audio-center">
        <div class="post-audio-header">
          <div class="post-audio-title-group">
            <span class="post-audio-badge">
              <span class="post-audio-eq" aria-hidden="true">
                <span></span><span></span><span></span><span></span>
              </span>
              <span data-i18n-key="<%= badgeI18nKey %>"><%= badgeDefaultText %></span>
            </span>
            <span class="post-audio-live-caption" data-audio-live-caption>
              <span class="post-audio-live-caption-track" data-audio-live-caption-track data-i18n-key="post.audio.captionHint">点击播放 · 支持字幕同步与段落点按跳转</span>
            </span>
          </div>

          <div class="post-audio-time" aria-live="off">
            <span class="post-audio-time-current" data-audio-current>00:00</span>
            <span class="post-audio-time-sep">/</span>
            <span class="post-audio-time-total" data-audio-duration><%= initialDuration %></span>
          </div>
        </div>

        <div class="post-audio-progress-wrap" data-audio-progress-wrap style="--audio-progress: 0%;">
          <div class="post-audio-track" aria-hidden="true">
            <div class="post-audio-fill" data-audio-fill></div>
            <div class="post-audio-thumb" data-audio-thumb></div>
          </div>
          <input
            type="range"
            class="post-audio-seek"
            data-audio-seek
            min="0"
            max="100"
            step="0.1"
            value="0"
            aria-label="Audio progress"
          />
        </div>
      </div>

      <div class="post-audio-controls">
        <button
          type="button"
          class="post-audio-skip-btn"
          data-audio-skip="-15"
          title="后退 15 秒 (-15s)"
          aria-label="Rewind 15 seconds"
        >
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
            <path d="M3 3v5h5"/>
          </svg>
          <span>15s</span>
        </button>

        <button
          type="button"
          class="post-audio-skip-btn"
          data-audio-skip="15"
          title="快进 15 秒 (+15s)"
          aria-label="Forward 15 seconds"
        >
          <span>15s</span>
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/>
            <path d="M21 3v5h-5"/>
          </svg>
        </button>

        <button
          type="button"
          class="post-audio-speed-btn"
          data-audio-speed
          title="切换倍速 (Playback speed)"
          aria-label="Playback speed"
        >1x</button>

        <% if (hasDrawer) { %>
          <button
            type="button"
            class="post-audio-drawer-btn"
            data-audio-drawer-toggle
            aria-expanded="true"
            aria-label="Toggle transcript and summary"
          >
            <span data-audio-drawer-label data-i18n-key="post.audio.scriptBtn">字幕 / 摘要</span>
            <svg class="post-audio-chevron" viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="5 8 10 13 15 8"/>
            </svg>
          </button>
        <% } %>
      </div>
    </div>

    <% if (hasDrawer) { %>
      <div class="post-audio-drawer" data-audio-drawer>
        <div class="post-audio-drawer-head">
          <div class="post-audio-tabs" role="tablist" aria-label="Audio companion views">
            <% if (paragraphs.length > 0) { %>
              <button
                type="button"
                role="tab"
                class="post-audio-tab is-active"
                data-audio-tab="transcript"
                aria-selected="true"
              >
                <span data-i18n-key="post.audio.tabTranscript">实时字幕文稿</span>
                <span class="post-audio-tab-count"><%= paragraphs.length %></span>
              </button>
            <% } %>
            <% if (highlights.length > 0) { %>
              <button
                type="button"
                role="tab"
                class="post-audio-tab<%= paragraphs.length === 0 ? ' is-active' : '' %>"
                data-audio-tab="summary"
                aria-selected="<%= paragraphs.length === 0 ? 'true' : 'false' %>"
              >
                <span data-i18n-key="post.audio.tabSummary">核心要点速览</span>
                <span class="post-audio-tab-count"><%= highlights.length %></span>
              </button>
            <% } %>
          </div>

          <span class="post-audio-drawer-hint" data-i18n-key="post.audio.clickSeekHint">
            点击任意字幕段落可直接跳转播放
          </span>
        </div>

        <% if (paragraphs.length > 0) { %>
          <div
            class="post-audio-panel post-audio-transcript"
            data-audio-panel="transcript"
            role="tabpanel"
          >
            <% paragraphs.forEach(function(item) { %>
              <div
                class="post-audio-cue"
                data-audio-cue
                data-cue-index="<%= item.index %>"
                data-start-ratio="<%= item.startRatio %>"
                data-end-ratio="<%= item.endRatio %>"
                data-start-sec="<%= item.startSec %>"
                tabindex="0"
                role="button"
                aria-label="Jump to <%= item.startTime %>"
              >
                <span class="post-audio-cue-time" data-cue-time><%= item.startTime %></span>
                <p class="post-audio-cue-text"><%= item.text %></p>
              </div>
            <% }); %>
          </div>
        <% } %>

        <% if (highlights.length > 0) { %>
          <div
            class="post-audio-panel post-audio-summary"
            data-audio-panel="summary"
            role="tabpanel"
            <%= paragraphs.length > 0 ? 'hidden' : '' %>
          >
            <ol class="post-audio-summary-list">
              <% highlights.forEach(function(point, idx) { %>
                <li class="post-audio-summary-item">
                  <span class="post-audio-summary-idx"><%= String(idx + 1).padStart(2, '0') %></span>
                  <p class="post-audio-summary-text"><%= point %></p>
                </li>
              <% }); %>
            </ol>
          </div>
        <% } %>
      </div>
    <% } %>
  </section>
<% } %>
