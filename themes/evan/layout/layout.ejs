<!doctype html>
<html lang="<%= config.language || 'zh-CN' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <% const social = social_meta(); %>
  <% const structured = structured_data(); %>
  <% const breadcrumb = breadcrumb_structured_data(); %>
  <meta name="description" content="<%= meta_description() %>" />
  <meta name="robots" content="<%= robots_meta() %>" />
  <link rel="canonical" href="<%= canonical_url() %>" />
  <meta property="og:title" content="<%= social.title %>" />
  <meta property="og:description" content="<%= social.description %>" />
  <meta property="og:url" content="<%= social.url %>" />
  <meta property="og:type" content="<%= social.type %>" />
  <meta property="og:image" content="<%= social.image %>" />
  <% if (social.imageType) { %><meta property="og:image:type" content="<%= social.imageType %>" /><% } %>
  <% if (social.imageWidth && social.imageHeight) { %>
    <meta property="og:image:width" content="<%= social.imageWidth %>" />
    <meta property="og:image:height" content="<%= social.imageHeight %>" />
  <% } %>
  <% if (social.imageAlt) { %><meta property="og:image:alt" content="<%= social.imageAlt %>" /><% } %>
  <% if (social.locale) { %><meta property="og:locale" content="<%= social.locale %>" /><% } %>
  <% if (social.articlePublishedTime) { %><meta property="article:published_time" content="<%= social.articlePublishedTime %>" /><% } %>
  <% if (social.articleModifiedTime) { %><meta property="article:modified_time" content="<%= social.articleModifiedTime %>" /><% } %>
  <% if (social.articleTags && social.articleTags.length) { %>
    <% social.articleTags.forEach(function(tag) { %><meta property="article:tag" content="<%= tag %>" /><% }) %>
    <meta name="keywords" content="<%= social.articleTags.join(', ') %>" />
  <% } %>
  <meta name="twitter:card" content="<%= social.twitterCard %>" />
  <meta name="twitter:title" content="<%= social.title %>" />
  <meta name="twitter:description" content="<%= social.description %>" />
  <meta name="twitter:image" content="<%= social.image %>" />
  <% if (social.imageAlt) { %><meta name="twitter:image:alt" content="<%= social.imageAlt %>" /><% } %>
  <% if (structured) { %><script type="application/ld+json"><%- JSON.stringify(structured) %></script><% } %>
  <% if (breadcrumb) { %><script type="application/ld+json"><%- JSON.stringify(breadcrumb) %></script><% } %>
  <title><%= page.title ? `${page.title} | ${config.title}` : config.title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="<%- url_for('/css/style.css') %>" />
  <script>
    // Apply language as early as possible.
    // Modes: en | zh
    (function () {
      try {
        var key = 'xdlkc:lang';
        var saved = localStorage.getItem(key);
        var mode = (saved === 'en' || saved === 'zh') ? saved : 'en';
        document.documentElement.dataset.langMode = mode;
        document.documentElement.lang = mode === 'zh' ? 'zh-CN' : 'en';
      } catch (e) {
        // ignore
      }
    })();
  </script>
  <script>
    // Apply theme as early as possible to reduce flash.
    // Modes: system | light | dark
    (function () {
      try {
        var key = 'xdlkc:theme';
        var savedMode = localStorage.getItem(key);
        var mode = (savedMode === 'dark' || savedMode === 'light' || savedMode === 'system')
          ? savedMode
          : 'system';
        var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = (mode === 'dark' || mode === 'light')
          ? mode
          : (prefersDark ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.themeMode = mode;
      } catch (e) {
        // ignore
      }
    })();
  </script>
</head>
<body>
  <a class="skip-link" href="#main-content" data-i18n-key="skip.main">Skip to content</a>
  <%- body %>
  <script src="<%- url_for('/js/lang-toggle.js') %>" defer></script>
  <script src="<%- url_for('/js/theme-toggle.js') %>" defer></script>
  <script src="<%- url_for('/js/font-size-toggle.js') %>" defer></script>
  <script src="<%- url_for('/js/back-to-top.js') %>" defer></script>
  <script src="<%- url_for('/js/code-copy.js') %>" defer></script>
  <script src="<%- url_for('/js/code-collapse.js') %>" defer></script>
  <script src="<%- url_for('/js/scroll-restore.js') %>" defer></script>
  <script src="<%- url_for('/js/external-links.js') %>" defer></script>
  <script src="<%- url_for('/js/site-search.js') %>" defer></script>
  <script>
    window.addEventListener('DOMContentLoaded', function() {
      window.LangToggle && window.LangToggle.initLangToggle && window.LangToggle.initLangToggle();
      window.SiteSearch && window.SiteSearch.initSiteSearch && window.SiteSearch.initSiteSearch();
      window.BackToTop && window.BackToTop.initBackToTop && window.BackToTop.initBackToTop();
      window.CodeCopy && window.CodeCopy.initCodeCopy && window.CodeCopy.initCodeCopy();
      window.CodeCollapse && window.CodeCollapse.initCodeCollapse && window.CodeCollapse.initCodeCollapse();
      window.ScrollRestore && window.ScrollRestore.initScrollRestore && window.ScrollRestore.initScrollRestore();
      window.ExternalLinks && window.ExternalLinks.initExternalLinks && window.ExternalLinks.initExternalLinks();
      window.FontSizeToggle && window.FontSizeToggle.init && window.FontSizeToggle.init();
    });
  </script>
</body>
</html>
