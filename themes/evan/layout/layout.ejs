<!doctype html>
<html lang="<%= config.language || 'zh-CN' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <% const social = social_meta(); %>
  <% const structured = structured_data(); %>
  <meta name="description" content="<%= meta_description() %>" />
  <link rel="canonical" href="<%= canonical_url() %>" />
  <meta property="og:title" content="<%= social.title %>" />
  <meta property="og:description" content="<%= social.description %>" />
  <meta property="og:url" content="<%= social.url %>" />
  <meta property="og:type" content="<%= social.type %>" />
  <meta property="og:image" content="<%= social.image %>" />
  <% if (social.locale) { %><meta property="og:locale" content="<%= social.locale %>" /><% } %>
  <% if (social.articlePublishedTime) { %><meta property="article:published_time" content="<%= social.articlePublishedTime %>" /><% } %>
  <% if (social.articleModifiedTime) { %><meta property="article:modified_time" content="<%= social.articleModifiedTime %>" /><% } %>
  <% if (social.articleTags && social.articleTags.length) { %>
    <% social.articleTags.forEach(function(tag) { %><meta property="article:tag" content="<%= tag %>" /><% }) %>
    <meta name="keywords" content="<%= social.articleTags.join(', ') %>" />
  <% } %>
  <meta name="twitter:card" content="<%= social.twitterCard %>" />
  <meta name="twitter:title" content="<%= social.title %>" />
  <meta name="twitter:description" content="<%= social.description %>" />
  <meta name="twitter:image" content="<%= social.image %>" />
  <% if (structured) { %><script type="application/ld+json"><%- JSON.stringify(structured) %></script><% } %>
  <title><%= page.title ? `${page.title} | ${config.title}` : config.title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="<%- url_for('/css/style.css') %>" />
</head>
<body>
  <%- body %>
</body>
</html>

