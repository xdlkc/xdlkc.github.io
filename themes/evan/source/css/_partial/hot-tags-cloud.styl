/* Hot Tags Cloud */

.hot-tags-cloud {
  margin-bottom: 30px;
  padding: 20px;
  background: var(--card);
  border-radius: 8px;
  border: 1px solid var(--border);
}

.hot-tags-cloud h3 {
  margin: 0 0 15px 0;
  font-size: 1.2rem;
  font-weight: 600;
  color: var(--text);
  border-bottom: 2px solid var(--accent);
  padding-bottom: 8px;
}

.tags-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  line-height: 1.5;
}

.tag-cloud-item {
  display: inline-block;
  text-decoration: none;
  color: var(--accent);
  transition: all 0.3s ease;
  padding: 4px 8px;
  border-radius: 4px;
  background: transparent;
  font-weight: 500;
}

.tag-cloud-item:hover {
  background: var(--accent);
  color: white;
  transform: translateY(-2px);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.tag-cloud-item:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

/* Responsive */
@media (max-width: 768px) {
  .hot-tags-cloud {
    padding: 15px;
  }

  .tags-cloud {
    gap: 8px;
  }

  .tag-cloud-item {
    padding: 3px 6px;
  }
}
